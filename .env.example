# --- Browser (safe to expose; protected by row-level security) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: closed-app push alerts. Generate the pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Server only (Vercel project settings; never prefix these with VITE_) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=a-long-random-string
